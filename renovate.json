{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:biomeVersions"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["every weekend"],
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["dependency-cruiser"],
      "groupName": null,
      "automerge": false,
      "prBodyNotes": [
        "If this release supports TypeScript 7, remove the dependency-cruiser entry from packageExtensions in pnpm-workspace.yaml (sverweij/dependency-cruiser#1069)."
      ]
    }
  ]
}
